{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dharanipathirk/neural-audio-bench/schemas/config.schema.json",
  "title": "neural-audio-bench configuration",
  "type": "object",
  "required": ["schema_version", "sample_rate", "models", "isolated", "contention", "backends", "model_sizes"],
  "properties": {
    "schema_version": { "const": 1 },
    "sample_rate": { "type": "integer", "minimum": 8000 },
    "models_manifest": {
      "type": "string",
      "description": "Path to the model manifest, relative to this config file's directory."
    },
    "virtual_output_devices": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Output device name substrings accepted for contention mode (a virtual loopback device delivers real callback deadline pressure without physical hardware)."
    },
    "models": {
      "type": "object",
      "description": "Architecture hyperparameters per size tier, consumed by the model exporter and the RTNeural catalog.",
      "properties": {
        "lstm": { "$ref": "#/$defs/sizeTiers" },
        "tcn": { "$ref": "#/$defs/sizeTiers" },
        "wavenet": { "$ref": "#/$defs/sizeTiers" }
      },
      "additionalProperties": { "$ref": "#/$defs/sizeTiers" }
    },
    "isolated": {
      "type": "object",
      "required": ["buffer_sizes", "warmup_iterations", "target_measure_seconds", "min_iterations", "num_reps", "throughput_seconds"],
      "properties": {
        "buffer_sizes": { "$ref": "#/$defs/bufferSizes" },
        "warmup_iterations": { "type": "integer", "minimum": 0 },
        "target_measure_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "min_iterations": { "type": "integer", "minimum": 1 },
        "num_reps": { "type": "integer", "minimum": 1 },
        "throughput_seconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "contention": {
      "type": "object",
      "required": ["buffer_sizes", "contention_levels", "instance_counts", "neural_track_depths", "use_system_au", "warmup_callbacks", "warmup_min_seconds", "measure_seconds", "num_reps", "num_tracks"],
      "properties": {
        "buffer_sizes": { "$ref": "#/$defs/bufferSizes" },
        "contention_levels": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Requested conventional-track counts for built-in Dimension A. The paper's fixed system-AU layout clamps these to 23; values 24 and 36 are retained as historical labels." },
        "instance_counts": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "neural_track_depths": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "use_system_au": { "type": "boolean" },
        "warmup_callbacks": { "type": "integer", "minimum": 0 },
        "warmup_min_seconds": { "type": "number", "minimum": 0 },
        "measure_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "num_reps": { "type": "integer", "minimum": 1 },
        "num_tracks": { "type": "integer", "minimum": 15, "description": "Track count for the custom-DSP Dimension A fallback; track index 15 hosts the neural model. The paper's fixed system-AU layout always has 36 tracks." }
      }
    },
    "backends": {
      "type": "object",
      "description": "Backend name -> enabled. A name is used when it matches a backend registered in the selected engine binary; this permits third-party backends without changing the schema.",
      "patternProperties": {
        "^_": {},
        "^[A-Za-z]": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "model_sizes": {
      "type": "object",
      "description": "Optional size-tier selectors. Manifest tiers absent here default to enabled.",
      "patternProperties": {
        "^_": {},
        "^[A-Za-z]": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "model_types": {
      "type": "object",
      "description": "Optional architecture selectors. Manifest architectures absent here default to enabled.",
      "patternProperties": {
        "^_": {},
        "^[A-Za-z]": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "custom_scenarios": {
      "type": "array",
      "description": "Optional data-driven contention scenarios (ConfigurableScenario). Each entry registers an extra sweep after the built-in dimensions A/B/C. Absent in the standard configs.",
      "items": {
        "type": "object",
        "required": ["id", "sweep", "buffer_sizes", "tracks"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Scenario id — becomes the CSV 'dimension' column value (with an additional '<id>_cb' row per config)."
          },
          "sweep": {
            "type": "object",
            "required": ["parameter", "values"],
            "properties": {
              "parameter": {
                "type": "string",
                "description": "Human-readable name of the swept parameter (e.g. 'track_count')."
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "integer", "minimum": 0 },
                "description": "Sweep values; each is written to the CSV contention_level column."
              }
            },
            "additionalProperties": false
          },
          "buffer_sizes": { "$ref": "#/$defs/bufferSizes" },
          "tracks": {
            "type": "array",
            "minItems": 1,
            "description": "Track groups. Exactly one group should set 'neural': true so the run is measurable.",
            "items": {
              "type": "object",
              "properties": {
                "count": {
                  "description": "Number of tracks in this group; the string \"sweep\" means the current sweep value.",
                  "oneOf": [
                    { "type": "integer", "minimum": 0 },
                    { "const": "sweep" }
                  ]
                },
                "neural": {
                  "type": "boolean",
                  "description": "This group's tracks host the neural plugin under test."
                },
                "clip": {
                  "const": "noise",
                  "description": "Audio source for the track ('noise' is currently the only option)."
                },
                "chain": {
                  "type": "array",
                  "items": { "enum": ["eq", "compressor", "reverb", "delay"] },
                  "description": "Plugin chain (pre-neural chain on a neural track)."
                },
                "chain_after": {
                  "type": "array",
                  "items": { "enum": ["eq", "compressor", "reverb", "delay"] },
                  "description": "Post-neural plugin chain (neural tracks only)."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": { "^_": {} },
  "additionalProperties": false,
  "$defs": {
    "bufferSizes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 1, "maximum": 2048 }
    },
    "sizeTiers": {
      "type": "object",
      "patternProperties": {
        "^_": {},
        "^[A-Za-z]": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    }
  }
}
